# Line endings: store text as LF in the repo, regardless of contributor OS.
# `eol=lf` overrides a contributor's core.autocrlf=true, so the working tree is LF too
# (this is what stops the "CRLF will be replaced by LF" warnings once normalized).
* text=auto eol=lf

# Explicit for the source types this repo actually carries (documentation of intent;
# the catch-all above already covers them).
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.ps1    text eol=lf
*.sh     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.ico  binary
docs/docs-index.js merge=coord-regen
docs/audit/audit-data.js merge=coord-regen
docs/audit/index.html merge=coord-regen
docs/audit/audit-log.jsonl merge=coord-register
docs/audit/change-log.jsonl merge=coord-register
docs/health-history.jsonl merge=coord-register
docs/portal/portal-data.js merge=coord-regen
web/pack-index.js merge=coord-regen
docs/_site/bundle.html merge=coord-regen
