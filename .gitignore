# Dependencies
node_modules/
venv/
.venv/
__pycache__/

# Build output
dist/
build/
test-results/
playwright-report/
*.jsonl.lock

# Environment / secrets
.env
.env.local

# Claude Code local settings (the generated .claude/{knowledge,skills,agents} ARE tracked)
.claude/settings.local.json

# Spike Protocol scratch probes (kept locally unless a probe is worth keeping as evidence)
spikes/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Obsidian lens - per-user state (the vault CONFIG is committed; this is not)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache/
docs/.obsidian/plugins/*/data.json
docs/.obsidian/plugins/*/main.js
docs/.obsidian/plugins/*/styles.css

# Graphify code knowledge graph - a build output, regenerable from source (GK3)
graphify-out/

# --- AI-Forward: visual-asset hygiene (ui-visual-assets.md) ---
# candidate boards and rejected generations - never committed
docs/assets/**/_scratch/
# project MCP config holds real credentials (VA9, VA22) - the .example is committed
.mcp.json
# credentials live in the environment, never in the repo (VA9)
*.env

# Pages build artifact (generated by tools/build-pages-bundle.py)
_site/

# --- AI-Forward: federation local-only data (ADR-0006 + publish boundary) ---
# Manifests name local repo paths and plans embed per-repo register additions;
# they are LOCAL working/record data - never committed to the public repo, never published.
learnings/manifests/
learnings/plans/
