{
  "mcpServers": {
    "higgsfield": {
      "type": "local",
      "command": "node",
      "args": [
        "<path to higgsfield-mcp/src/server.js>"
      ],
      "tools": [
        "*"
      ],
      "env": {
        "HF_API_KEY": "<your HF_API_KEY>",
        "HF_SECRET": "<your HF_SECRET>"
      }
    }
  }
}
