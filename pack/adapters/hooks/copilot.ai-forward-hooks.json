{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 docs/ai-forward-pack/hooks/reread-guard.py --host copilot",
        "powershell": "python docs/ai-forward-pack/hooks/reread-guard.py --host copilot",
        "timeoutSec": 10,
        "matcher": "^view$"
      },
      {
        "type": "command",
        "bash": "python3 docs/ai-forward-pack/hooks/mail-doorbell.py --host copilot --event preToolUse",
        "powershell": "python docs/ai-forward-pack/hooks/mail-doorbell.py --host copilot --event preToolUse",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 docs/ai-forward-pack/hooks/reread-guard.py --host copilot",
        "powershell": "python docs/ai-forward-pack/hooks/reread-guard.py --host copilot",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 docs/ai-forward-pack/hooks/mail-doorbell.py --host copilot --event agentStop",
        "powershell": "python docs/ai-forward-pack/hooks/mail-doorbell.py --host copilot --event agentStop",
        "timeoutSec": 10
      }
    ]
  }
}
